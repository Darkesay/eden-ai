# GEMINI_API_KEY: Required for live agronomist consultation, speech-to-text, and plant diagnostics.
# In production on Render, set this in Render Dashboard > Environment Variables.
# NEVER expose this key in frontend code or Git.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Voice & Speech Configuration (Server-Side)
# Maximum allowed audio voice note size in MB (defaults to 15MB)
AUDIO_MAX_UPLOAD_MB=15

# EDENS AI specific configuration
VITE_MQTT_BROKER_URL="wss://broker.hivemq.com:8884/mqtt"
VITE_ESP32_CAM_STREAM_URL="http://placeholder-ip:81/stream"

# Hardware Integration Gateway (Server-Side Secrets, never exposed to client bundles)
# Static IP or mDNS address of the main ESP32 controller
HARDWARE_CONTROLLER_HOST=""
HARDWARE_CONTROLLER_PORT=80
# Secret firmware authorization key for main controller commands
HARDWARE_API_KEY=""

# ESP32-CAM Push Upload Secret Key (Intake Authentication for POST /api/camera/upload)
# The ESP32 camera or local LAN relay must send this value in the X-Camera-Key HTTP header.
# REQUIRED: Must be set to a secure, private random key in production (e.g. Render Environment Variables).
# Never expose this key in frontend code, public URLs, logs, or Git commits.
CAMERA_UPLOAD_KEY="change_this_to_a_secure_camera_secret"

# Maximum allowed JPEG upload size in MB (defaults to 10MB)
CAMERA_MAX_UPLOAD_MB=10

# Persistent Disk Storage Path (Optional: mount path for Render Persistent Disk, e.g. /var/data or /data)
# If not set, defaults to local project directory ./uploads/camera
CAMERA_STORAGE_PATH=""

# ESP32-CAM module address (Optional: local LAN gateway pull model GET /photo, GET /status, :81/stream)
HARDWARE_CAMERA_HOST=""
HARDWARE_CAMERA_HTTP_PORT=80
HARDWARE_CAMERA_PORT=81
