# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# EDENS AI specific configuration
VITE_MQTT_BROKER_URL="wss://broker.hivemq.com:8884/mqtt"
VITE_ESP32_CAM_STREAM_URL="http://placeholder-ip:81/stream"

# Hardware Integration Gateway (Server-Side Secrets, never exposed to client bundles)
# Static IP or mDNS address of the main ESP32 controller
HARDWARE_CONTROLLER_HOST=""
HARDWARE_CONTROLLER_PORT=80
# Secret firmware authorization key for main controller commands
HARDWARE_API_KEY=""

# ESP32-CAM Push Upload Secret Key (Intake Authentication for POST /api/camera/upload)
# The ESP32 camera must send this value in the X-Camera-Key header or ?token= query parameter
CAMERA_UPLOAD_KEY="edens_camera_secret_2026"
# Maximum allowed JPEG upload size in MB (defaults to 10MB)
CAMERA_MAX_UPLOAD_MB=10

# ESP32-CAM module address (Optional: for legacy pull model GET /capture)
HARDWARE_CAMERA_HOST=""
HARDWARE_CAMERA_PORT=81
