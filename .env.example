# ==============================================================================
# EDENS AI — Environment Configuration (.env.example)
# Copy to .env for local development or configure in Render > Environment.
# NEVER commit real API keys, device tokens, or Wi-Fi passwords to Git.
# ==============================================================================

# 1. Gemini AI (Automatically provided in AI Studio; set in Render > Environment for production)
GEMINI_API_KEY=""

# 2. Public Application URL (Automatically provided in AI Studio; set on Render if needed)
APP_URL=""

# ==============================================================================
# OPTIONAL PRODUCTION & HARDWARE TUNING OVERRIDES
# Uncomment and set ONLY when customizing Render, Vercel, or lab hardware defaults.
# ==============================================================================

# Node.js runtime & allowed cross-origin frontend domains on Render:
# NODE_VERSION="22.18.0"
# CORS_ALLOWED_ORIGINS="https://eden-ai.vercel.app,https://edens-ai.onrender.com"

# Optional Frontend API Base URL:
# Leave unset/empty when served by `node server.ts` on Render OR when using `vercel.json` `/api/:path*` rewrites.
# Set to "https://edens-ai.onrender.com" ONLY if hosting static files without `/api/*` proxy rewrites.
# VITE_API_BASE_URL=""

# Persistent Storage Paths (Recommended on Render with a Persistent Disk mounted at /var/data):
# Defaults locally to ./data/edens_platform.sqlite and ./uploads/camera when unset.
# DATABASE_PATH="/var/data/edens_platform.sqlite"
# DATABASE_DRIVER="auto"
# CAMERA_STORAGE_PATH="/var/data/camera_uploads"
# SESSION_TTL_HOURS="168"

# Configurable Tiered Data Retention (Phase 1 Data Foundation Defaults):
# TELEMETRY_RAW_RETENTION_DAYS="90"
# TELEMETRY_HOURLY_RETENTION_DAYS="365"
# TELEMETRY_DAILY_RETENTION_DAYS="1825"
# AI_OBSERVATION_RETENTION_DAYS="365"
# AUDIT_LOG_RETENTION_DAYS="1825"
# CAMERA_ROUTINE_MAX_FILES="48"
# CAMERA_ROUTINE_MAX_DAYS="1"
# CAMERA_CURATED_MAX_FILES="500"

# Optional Global Lab Intake Keys (Per-greenhouse kits use unique edcam_* / edctrl_* keys from the Setup Wizard):
# CAMERA_UPLOAD_KEY=""
# CAMERA_MAX_UPLOAD_MB="10"
# CAMERA_FRESH_MAX_SECONDS="90"
# HARDWARE_API_KEY=""

# Voice & Speech Upload Limit:
# AUDIO_MAX_UPLOAD_MB="15"

# Optional Local LAN Diagnostics & Raw TCP MQTT Broker (Leave unset on cloud hosts; Render uses WSS /api/iot/mqtt-ws on PORT):
# MQTT_TCP_PORT=""
# HARDWARE_CONTROLLER_HOST=""
# HARDWARE_CONTROLLER_PORT="80"
# HARDWARE_CAMERA_HOST=""
# HARDWARE_CAMERA_HTTP_PORT="80"
# HARDWARE_CAMERA_PORT="81"
# VITE_ESP32_CAM_STREAM_URL=""

