# ==============================================================================
# EDENS AI — Server Environment Configuration (.env.example)
# Copy to .env for local development or configure in Render > Environment.
# NEVER commit real API keys, device tokens, or Wi-Fi passwords to Git.
# ==============================================================================

# 1. Gemini AI (REQUIRED for VisionAgent, Agronomist Chat, Harvest Prediction & Speech)
GEMINI_API_KEY="REPLACE_WITH_GEMINI_API_KEY"

# 2. Public Application URL (Used for QR enrollment links & upload-info metadata)
APP_URL="https://edens-ai.onrender.com"

# 3. ESP32-CAM Cloud Intake Secret (Independent from Controller Auth)
# Used ONLY for global/lab camera uploads to POST /api/camera/upload via X-Camera-Key header.
# Per-greenhouse enrolled cameras use unique edcam_* keys issued in the Setup Wizard (stored as SHA-256 in SQLite).
CAMERA_UPLOAD_KEY="REPLACE_WITH_RANDOM_32_BYTE_CAMERA_UPLOAD_KEY"
CAMERA_MAX_UPLOAD_MB=10
CAMERA_FRESH_MAX_SECONDS=90

# 4. Main ESP32 Controller Cloud Intake Secret (Independent from Camera Auth)
# Used ONLY for global/lab controller uploads to POST /api/telemetry/upload via X-Hardware-Key header.
# Per-greenhouse enrolled controllers use unique edctrl_* keys issued in the Setup Wizard (stored as SHA-256 in SQLite).
HARDWARE_API_KEY="REPLACE_WITH_RANDOM_32_BYTE_HARDWARE_API_KEY"

# 5. Persistent Storage Paths (CRITICAL on Render so SQLite & snapshots survive redeploys)
# Attach a Render Persistent Disk mounted at /var/data and set both paths below:
DATABASE_PATH=""
CAMERA_STORAGE_PATH=""
SESSION_TTL_HOURS=168

# 6. Voice & Speech Limits
AUDIO_MAX_UPLOAD_MB=15

# 7. Optional Local LAN Diagnostics Only (Leave empty on Render Cloud; cloud cannot reach private LAN IPs)
HARDWARE_CONTROLLER_HOST=""
HARDWARE_CONTROLLER_PORT=80
HARDWARE_CAMERA_HOST=""
HARDWARE_CAMERA_HTTP_PORT=80
HARDWARE_CAMERA_PORT=81
VITE_ESP32_CAM_STREAM_URL=""
